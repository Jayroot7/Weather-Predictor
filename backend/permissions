/* ============================================================
   WEATHER PREDICTOR - FUNCTION PERMISSIONS
   ============================================================ */


/* ============================================================
   GET WEATHER LOCATIONS

   Used by the public website to populate the location dropdown.
   ============================================================ */

REVOKE ALL
ON FUNCTION public.get_weather_locations()
FROM PUBLIC;

GRANT EXECUTE
ON FUNCTION public.get_weather_locations()
TO anon;

GRANT EXECUTE
ON FUNCTION public.get_weather_locations()
TO authenticated;

GRANT EXECUTE
ON FUNCTION public.get_weather_locations()
TO service_role;


